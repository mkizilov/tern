(library
 (name tern)
 (public_name ternc)
 (libraries sedlex menhirLib unix uucp)
 (preprocess
  (pps ppx_deriving.show ppx_deriving.eq sedlex.ppx)))

(menhir
 (modules grammar)
 (flags --strict --table)
 (explain true))

(rule
 (target grammar_messages.ml)
 (deps grammar.mly grammar.messages)
 (action
  (with-stdout-to
   %{target}
   (run
    %{bin:menhir}
    --strict
    --table
    --compile-errors
    grammar.messages
    grammar.mly))))

(rule
 (target runtime_assets.ml)
 (deps ../runtime/runtime.wat ../runtime/run.mjs)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let wat = {tern_wat|")
    (cat ../runtime/runtime.wat)
    (echo "|tern_wat}\nlet host = {tern_host|")
    (cat ../runtime/run.mjs)
    (echo "|tern_host}")))))
