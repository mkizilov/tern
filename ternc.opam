opam-version: "2.0"
version: "0.1.0"
synopsis: "Tern functional language compiler targeting WebAssembly"
description:
  "A statically typed functional language with Hindley-Milner inference."
depends: [
  "ocaml" {>= "5.1" & < "6.0"}
  "dune" {>= "3.20"}
  "menhir"
  "sedlex" {>= "3.6"}
  "ppx_deriving"
  "ppx_expect"
  "qcheck"
  "js_of_ocaml"
  "js_of_ocaml-ppx"
  "ocamlformat" {= "0.29.0"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
